.env
.terraform
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
talosconfig
kubeconfig
age.agekey
.vagrant
.envrc
.ansible
# plaintext `talosctl gen config` output, in any directory
controlplane.yaml
worker.yaml

# all secrets
**/secrets/**
# allow traversal of secrets dirs
!**/secrets/**/
# allow sops files in secrets dirs
!**/secrets/*.sops*
!**/secrets/**/kustomizeconfig.yaml
!**/secrets/**/*.sops*
# talos: only secrets are ignored, except their sops-encrypted files
talos/secrets/*
!talos/secrets/*.sops.yaml
# talos role patches share those names but hold no secrets
!talos/controlplane.yaml
!talos/worker.yaml
# allow kustomization.yaml in secrets dirs
!**/secrets/**/kustomization.yaml
terraform/.bitwarden
terraform/.bw-provider-state
