{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jasonpanosso/renovate-config",
    "github>jasonpanosso/selfhosted//.renovate/cnpg.json",
    "github>jasonpanosso/selfhosted//.renovate/flake.json",
    "github>jasonpanosso/selfhosted//.renovate/grafanaDashboards.json",
    "github>jasonpanosso/selfhosted//.renovate/groups.json",
    "github>jasonpanosso/selfhosted//.renovate/minecraft.json",
    "github>jasonpanosso/selfhosted//.renovate/opentofu.json",
    "github>jasonpanosso/selfhosted//.renovate/sourceUrls.json",
    "github>jasonpanosso/selfhosted//.renovate/talos.json"
  ],
  "packageRules": [
    {
      "description": "Pin OCIRepository chart digests (spec.ref.digest) and manifest images",
      "matchManagers": ["flux", "kubernetes"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Silo has no releases before 1.0, only build-N tags off main",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/silo-server/silo-server"],
      "versioning": "regex:^build-(?<major>\\d+)$",
      "maxMajorIncrement": 0,
      "schedule": ["* * * * 1"],
      "updateNotScheduled": false
    }
  ],
  "flux": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  }
}
