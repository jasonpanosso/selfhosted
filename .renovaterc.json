{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>jasonpanosso/selfhosted//.renovate/autoMerge.json",
    "github>jasonpanosso/selfhosted//.renovate/customManagers.json",
    "github>jasonpanosso/selfhosted//.renovate/grafanaDashboards.json",
    "github>jasonpanosso/selfhosted//.renovate/groups.json",
    "github>jasonpanosso/selfhosted//.renovate/labels.json",
    "github>jasonpanosso/selfhosted//.renovate/semanticCommits.json",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(America/Detroit)"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "ignorePaths": ["**/*.sops.*", "**/*.md", "terraform"],
  "packageRules": [
    {
      "description": "Eclipse Temurin JRE tags (e.g. 25.0.5_8-jre-noble, 25.0.4.1_1-jre-noble)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/eclipse-temurin$/"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?_(?<revision>\\d+)(?<compatibility>-jre-noble)$"
    }
  ],
  "flux": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"]
  }
}
