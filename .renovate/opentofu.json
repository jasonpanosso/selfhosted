{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Use OpenTofu registry intead of Terraform registry",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "required_version in `backend.tf` is checked against the tofu binary",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "overrideDepName": "opentofu/opentofu",
      "overridePackageName": "opentofu/opentofu"
    },
    {
      "description": "OpenTofu Group: tofu in flake.nix and required_version in terraform/backend.tf",
      "groupName": "OpenTofu",
      "matchPackageNames": ["opentofu/opentofu"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    }
  ]
}
