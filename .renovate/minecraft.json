{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customDatasources": {
    "curseforge-modpacks": {
      "description": "cfwidget mirrors the CurseForge file list without needing an API key",
      "defaultRegistryUrlTemplate": "https://api.cfwidget.com/minecraft/modpacks/{{packageName}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [files[type=\"release\"].{\"version\": name, \"releaseTimestamp\": uploaded_at}], \"homepage\": urls.curseforge}"
      ]
    },
    "modrinth-velocity": {
      "description": "Modrinth version id is passed as the digest, since CDN URLs carry it next to the version number",
      "defaultRegistryUrlTemplate": "https://api.modrinth.com/v2/project/{{packageName}}/version?loaders=%5B%22velocity%22%5D",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$.{\"version\": version_number, \"releaseTimestamp\": date_published, \"digest\": id}]}"
      ]
    },
    "modrinth-modpacks": {
      "defaultRegistryUrlTemplate": "https://api.modrinth.com/v2/project/{{packageName}}/version",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$[version_type=\"release\"].{\"version\": version_number, \"releaseTimestamp\": date_published}]}"
      ]
    }
  },
  "customManagers": [
    {
      "description": "itzg AUTO_CURSEFORGE packs pinned with CF_FILENAME_MATCHER",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)kubernetes/apps/minecraft/.+\\.ya?ml$/"],
      "matchStrings": [
        "- name: CF_SLUG\\n\\s+value: (?<depName>\\S+)\\n\\s+- name: CF_FILENAME_MATCHER\\n\\s+value: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "custom.curseforge-modpacks",
      "versioningTemplate": "deb"
    },
    {
      "description": "itzg MODRINTH packs pinned in the MODRINTH_MODPACK URL",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)kubernetes/apps/minecraft/.+\\.ya?ml$/"],
      "matchStrings": [
        "- name: MODRINTH_MODPACK\\n\\s+value: https://modrinth\\.com/modpack/(?<depName>[^/\\s]+)/version/(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "custom.modrinth-modpacks"
    },
    {
      "description": "Simple Voice Chat Velocity plugin downloaded from the Modrinth CDN; the URL's version id is tracked as the digest",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)kubernetes/apps/minecraft/minecraft-proxy/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://cdn\\.modrinth\\.com/data/9eGKb6K1/versions/(?<currentDigest>[^/]+)/voicechat-(?<currentValue>velocity-[^/]+)\\.jar"
      ],
      "depNameTemplate": "simple-voice-chat",
      "packageNameTemplate": "simple-voice-chat",
      "datasourceTemplate": "custom.modrinth-velocity",
      "versioningTemplate": "regex:^velocity-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "CF file names look like Society-Sunlit-Cobblemon-1.1.4-SSV4.1.5A.zip; CF_FILENAME_MATCHER takes the part after the pack name",
      "matchDatasources": ["custom.curseforge-modpacks"],
      "extractVersion": "-(?<version>\\d+\\.\\S+)\\.zip$"
    },
    {
      "matchDatasources": [
        "custom.curseforge-modpacks",
        "custom.modrinth-modpacks"
      ],
      "addLabels": ["renovate/modpack"],
      "semanticCommitScope": "modpack",
      "commitMessageTopic": "modpack {{depName}}",
      "prBodyNotes": [
        "Modpack updates can break existing worlds. Read the changelog, and check that `VERSION` still matches the pack's Minecraft version."
      ]
    },
    {
      "description": "Eclipse Temurin JRE tags (e.g. 25.0.5_8-jre-noble, 25.0.4.1_1-jre-noble)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/eclipse-temurin$/"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?_(?<revision>\\d+)(?<compatibility>-jre-noble)$",
      "allowedVersions": "/^25\\./"
    },
    {
      "description": "Only open eclipse temurin updates on Mondays",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/eclipse-temurin$/"],
      "schedule": ["* * * * 1"]
    }
  ]
}
