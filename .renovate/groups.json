{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Flux Operator Group",
      "groupName": "Flux Operator",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/flux-operator/", "/flux-instance/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Rook-Ceph Group",
      "groupName": "Rook-Ceph",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/rook-ceph/", "/rook-ceph-cluster/", "/ceph-csi-drivers/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "deadvalues Group: the action's digest and its version input",
      "groupName": "deadvalues",
      "matchPackageNames": ["guarnz/deadvalues"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Containers repo images: group digest-only rebuilds",
      "groupName": "Personal containers repo digests",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^ghcr\\.io/jasonpanosso//"],
      "matchUpdateTypes": ["digest"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Talos Group: installer images and talosctl in flake.nix",
      "groupName": "Talos",
      "matchPackageNames": ["ghcr.io/siderolabs/installer-base", "siderolabs/talos"],
      "separateMultipleMinor": true,
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "OpenTofu Group: tofu in flake.nix and required_version in terraform/backend.tf",
      "groupName": "OpenTofu",
      "matchPackageNames": ["opentofu/opentofu"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "Kubernetes Group: control plane images and kubectl in flake.nix",
      "groupName": "Kubernetes",
      "matchPackageNames": [
        "kubernetes/kubernetes",
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kube-proxy"
      ],
      "separateMultipleMinor": true,
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    }
  ]
}
