{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated dependencies",
      "managerFilePatterns": [
        "/(^|/).+\\.env$/",
        "/(^|/).+\\.sh$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      "description": "CloudNativePG Cluster imageName",
      "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      "matchStrings": [
        "imageName: (?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[0-9a-f]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Talos installer images in Talos patches",
      "managerFilePatterns": ["/(^|/)talos/.+\\.ya?ml$/"],
      "matchStrings": ["factory\\.talos\\.dev/metal-installer/[0-9a-f]{64}:v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "ghcr.io/siderolabs/installer-base",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "GitHub release binaries in flake.nix; the match runs to the end of the url so every version in it is replaced",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": ["https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/v(?<currentValue>[^/]+)/[^\"]+"],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "kubectl binaries in flake.nix",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": ["https://dl\\.k8s\\.io/release/(?<currentValue>v[^/]+)/[^\"]+"],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Kubernetes images in Talos patches",
      "managerFilePatterns": ["/(^|/)talos/.+\\.ya?ml$/"],
      "matchStrings": [
        "image: (?<depName>(ghcr\\.io/siderolabs/kubelet|registry\\.k8s\\.io/kube-(apiserver|controller-manager|scheduler|proxy))):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
