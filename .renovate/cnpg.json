{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "CloudNativePG extension image volumes (ClusterImageCatalog images[].extensions[].image.reference)",
      "managerFilePatterns": ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      "matchStrings": [
        "reference: (?<depName>ghcr\\.io/cloudnative-pg/[^\\s:@]+):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:[0-9a-f]{64}))?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "ClusterImageCatalog entries are keyed by major; a new major is a new catalog entry plus a Cluster imageCatalogRef.major bump, done by hand",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Only open pgvector updates (tags and digests) on Mondays",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/pgvector"],
      "schedule": ["* * * * 1"]
    },
    {
      "description": "Only open postgresql digest bumps on Mondays",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["* * * * 1"]
    }
  ]
}
